' Select the correct source worksheet
If sheetName = "Detained Ops IJ WebEx Data" Then

    On Error Resume Next
    Set srcWS = srcWB.Worksheets("IJ WebEX Info")
    On Error GoTo ImportFailed

    If srcWS Is Nothing Then
        Err.Raise vbObjectError + 405, , _
            "The WebEx file is missing the IJ WebEX Info worksheet."
    End If

Else

    Set srcWS = srcWB.Worksheets(1)

End If

' Validate the report's column headers
If Not ValidateReport(srcWS, sheetName) Then
    Err.Raise vbObjectError + 406, , _
        "The selected file did not pass report validation."
End If

