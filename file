
    // Remove repeated headers from individual court tables
    RemoveHeaders = Table.SelectRows(
        Combined,
        each [Column1] <> null
            and Text.Trim(Text.From([Column1])) <> "Judge Name"
    ),

    // Give columns meaningful names
    RenameColumns = Table.RenameColumns(
        RemoveHeaders,
        {
            {"Column1", "Judge Name"},
            {"Column2", "Internet-Based Hearing Link"},
            {"Column3", "Access Code"}
        }
    ),

    // Extract judge code from final parentheses
    AddJudgeCode = Table.AddColumn(
        RenameColumns,
        "Judge Code",
        each
            let
                Name = [Judge Name],
                Code = try Text.BetweenDelimiters(
                    Name, "(", ")", {0, RelativePosition.FromEnd}
                ) otherwise null
            in
                Code,
        type text
    )
in
    AddJudgeCode
