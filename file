
let
    URL = "https://www.justice.gov/eoir/find-immigration-court-and-access-internet-based-hearings",

    Source = Web.Page(Web.Contents(URL)),

    // Recognized administrative titles
    Titles = {"RDCIJ", "ACIJ", "DCIJ", "CIJ"},

    // Keep the immigration court tables
    Courts = Table.SelectRows(
        Source,
        each [Caption] <> null
            and Text.Contains(
                Text.From([Caption]),
                "Immigration Court",
                Comparer.OrdinalIgnoreCase
            )
            and [Data] is table
    ),

    KeepColumns = Table.SelectColumns(
        Courts,
        {"Caption", "Data"}
    ),

    RenameCourt = Table.RenameColumns(
        KeepColumns,
        {{"Caption", "Court"}}
    ),

    // Normalize each court's table
    NormalizeCourt = (t as table, court as text) as table =>
        let
            Cols = Table.ColumnNames(t),
            FirstThree = List.FirstN(Cols, 3),

            Selected = Table.SelectColumns(
                t,
                FirstThree
            ),

            TempNames = List.Transform(
                {1..List.Count(FirstThree)},
                each "TempColumn" & Text.From(_)
            ),

            TempRename = Table.RenameColumns(
                Selected,
                List.Zip({FirstThree, TempNames})
            ),

            StandardNames = Table.RenameColumns(
                TempRename,
                {
                    {"TempColumn1", "Judge Name"},
                    {"TempColumn2", "Internet-Based Hearing Link"},
                    {"TempColumn3", "Access Code"}
                }
            ),

            RemoveHeaders = Table.SelectRows(
                StandardNames,
                each [Judge Name] <> null
                    and Text.Trim(Text.From([Judge Name])) <> ""
                    and Text.Trim(Text.From([Judge Name])) <> "Judge Name"
            ),

            AddCourt = Table.AddColumn(
                RemoveHeaders,
                "Court",
                each court,
                type text
            )
        in
            AddCourt,

    AddJudges = Table.AddColumn(
        RenameCourt,
        "Judges",
        each NormalizeCourt([Data], [Court])
    ),

    Combined = Table.Combine(AddJudges[Judges]),

    // Extract a judge code only when the name
    // ends with a parenthesized value
    AddJudgeCode = Table.AddColumn(
        Combined,
        "Judge Code",
        each
            let
                Name = Text.Trim(Text.From([Judge Name])),
                OpenPos = Text.PositionOf(
                    Name,
                    "(",
                    Occurrence.Last
                ),
                HasCode = OpenPos >= 0
                    and Text.EndsWith(Name, ")"),
                Code = if HasCode then
                    Text.Trim(
                        Text.Middle(
                            Name,
                            OpenPos + 1,
                            Text.Length(Name) - OpenPos - 2
                        )
                    )
                else null
            in
                if Code = null or Code = ""
                then null
                else Code,
        type text
    ),

    // Extract any recognized leading title
    AddTitle = Table.AddColumn(
        AddJudgeCode,
        "Judge Title",
        each
            let
                Name = Text.Trim(Text.From([Judge Name])),
                FirstWord = Text.Upper(
                    List.First(
                        Text.Split(Name, " ")
                    )
                )
            in
                if List.Contains(Titles, FirstWord)
                then FirstWord
                else null,
        type text
    ),

    // Remove judge code and administrative title
    // without removing the actual judge
    CleanJudgeName = Table.AddColumn(
        AddTitle,
        "Judge Name Clean",
        each
            let
                Name = Text.Trim(Text.From([Judge Name])),
                Code = [Judge Code],
                Title = [Judge Title],

                WithoutCode =
                    if Code = null then Name
                    else Text.Trim(
                        Text.Start(
                            Name,
                            Text.PositionOf(
                                Name,
                                "(",
                                Occurrence.Last
                            )
                        )
                    ),

                WithoutTitle =
                    if Title = null then WithoutCode
                    else Text.Trim(
                        Text.Range(
                            WithoutCode,
                            Text.Length(Title)
                        )
                    )
            in
                WithoutTitle,
        type text
    ),

    // All fields stay as text
    SetTypes = Table.TransformColumnTypes(
        CleanJudgeName,
        {
            {"Judge Code", type text},
            {"Judge Title", type text},
            {"Judge Name Clean", type text},
            {"Judge Name", type text},
            {"Internet-Based Hearing Link", type text},
            {"Access Code", type text},
            {"Court", type text}
        }
    ),

    Final = Table.ReorderColumns(
        SetTypes,
        {
            "Judge Code",
            "Judge Name Clean",
            "Judge Title",
            "Judge Name",
            "Internet-Based Hearing Link",
            "Access Code",
            "Court"
        }
    )
in
    Final
