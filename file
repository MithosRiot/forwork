Function GenerateDashboardReport() As Boolean

    Dim dash As Worksheet
    Dim nextRow As Long
    Dim lastRow As Long

    On Error GoTo ReportFailed

    GenerateDashboardReport = False

    Set dash = ThisWorkbook.Worksheets("Dashboard")

    ' Preserve the summary through row 17.
    ' Clear previously generated details only.
    lastRow = dash.Cells(dash.Rows.Count, "A").End(xlUp).Row

    If lastRow >= 20 Then
        dash.Range("A20:F" & lastRow).Clear
    End If

    nextRow = 20

    ' ==================================
    ' ENHANCED DETAINED
    ' ==================================

    AddReportSection dash, nextRow, _
        "Results_EnhancedDetained", _
        "ENHANCED DETAINED - IJ ROLL-ONS", 1, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_EnhancedDetained", _
        "ENHANCED DETAINED - IJ ROLL-OFFS", 4, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_DFAS", _
        "ENHANCED DETAINED - VAV COURT ISSUES", 1, _
        Array("IJ Code", "Judge Name", "VAV Court", _
              "DFAS Court", "Verification Status")

    ' ==================================
    ' DETAINED OPS IJ WEBEX
    ' ==================================

    AddReportSection dash, nextRow, _
        "Results_WebEx", _
        "WEBEX - IJ ROLL-ONS", 1, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_WebEx", _
        "WEBEX - IJ ROLL-OFFS", 4, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_DFAS", _
        "WEBEX - VAV COURT ISSUES", 6, _
        Array("IJ Code", "Judge Name", "VAV Court", _
              "DFAS Court", "Verification Status")

    ' ==================================
    ' COMBINED HLOC CHANGES
    ' ==================================

    AddReportSection dash, nextRow, _
        "Results_HLOC", _
        "HLOC ROLL-ONS - ADD TO DFAS", 1, _
        Array("IJ Code", "Judge Name", "HLOC", _
              "DFAS Detail Court", "Change")

    AddReportSection dash, nextRow, _
        "Results_HLOC", _
        "HLOC ROLL-OFFS - REMOVE FROM DFAS", 7, _
        Array("IJ Code", "Judge Name", "HLOC", _
              "DFAS Detail Court", "Change")

    ' ==================================
    ' WEBEX HOME COURT CHECK
    ' ==================================

    AddReportSection dash, nextRow, _
        "Results_HLOC", _
        "WEBEX - HOME COURT = HLOC", 13, _
        Array("IJ Code", "Judge Name", "Home Court", _
              "HLOC", "DFAS Detail Court")

    GenerateDashboardReport = True

    Exit Function

ReportFailed:

    MsgBox "Dashboard generation failed: " & _
        Err.Description, vbCritical

    GenerateDashboardReport = False

End Function
