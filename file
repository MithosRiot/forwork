Sub ProcessAllReports()

    Dim tool As Worksheet
    Dim r As Long
    Dim missing As String

    Set tool = ThisWorkbook.Worksheets("Tool")

    ' Verify the currently selected reports
    UpdateStatuses

    For r = 6 To 8
        If tool.Cells(r, "B").Value <> "Imported" Then
            missing = missing & vbCrLf & _
                "- " & tool.Cells(r, "A").Value
        End If
    Next r

    If missing <> "" Then
        MsgBox "Cannot process reports. Check:" & _
            vbCrLf & missing, vbExclamation
        Exit Sub
    End If

    ' Mark Dashboard as needing refresh
    tool.Range("B11").Value = "Out of Date"

    ' Run all verification procedures
    CompareEnhancedDetained
    CompareWebEx
    CheckDFASVAV
    CheckDFASHLOC

    MsgBox "All verification procedures have finished." & _
        vbCrLf & _
        "Review the Results worksheets.", vbInformation

End Sub
