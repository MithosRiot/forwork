
Sub ProcessAllReports()

    Dim tool As Worksheet
    Dim r As Long
    Dim missing As String
    Dim previousED As Variant
    Dim previousWE As Variant
    Dim failureMessage As String

    On Error GoTo ProcessFailed

    Set tool = ThisWorkbook.Worksheets("Tool")

    ' Refresh report statuses and previous dates.
    UpdateStatuses
    UpdatePreviousReportDates

    ' Reset all five processing indicators.
    tool.Range("B25:B29").Value = "Not Run"
    tool.Range("B11").Value = "Out of Date"

    ' Verify all four current reports are available.
    For r = 6 To 9

        If tool.Cells(r, "B").Value <> "Imported" Then
            missing = missing & vbCrLf & _
                "- " & tool.Cells(r, "A").Value
        End If

    Next r

    If missing <> "" Then
        Err.Raise vbObjectError + 1301, , _
            "Missing or outdated reports:" & missing
    End If

    ' Find the most recent previous reports.
    previousED = GetPreviousReportDate( _
        "History_enhancedDetained", _
        DateValue(tool.Range("B3").Value))

    previousWE = GetPreviousReportDate( _
        "History_webEx", _
        DateValue(tool.Range("B3").Value))

    If IsEmpty(previousED) Or IsEmpty(previousWE) Then
        Err.Raise vbObjectError + 1302, , _
            "Previous Enhanced Detained or WebEx data is missing."
    End If

    ' Run all five checks, stopping if any fails.
    If Not CompareEnhancedDetained() Then GoTo CheckFailed

    If Not CompareWebEx() Then GoTo CheckFailed

    If Not CheckDFASVAV() Then GoTo CheckFailed

    If Not CheckDFASHLOC() Then GoTo CheckFailed

    If Not CheckVAVBooths() Then GoTo CheckFailed

    ' Build the complete Dashboard.
    If Not GenerateDashboardReport() Then GoTo CheckFailed

    ' Recalculate Dashboard summary formulas.
    Application.CalculateFull

    ' Record successful completion.
    tool.Range("B13").Value = Now
    tool.Range("B13").NumberFormat = _
        "m/d/yyyy h:mm AM/PM"

    tool.Range("B11").Value = "Up to Date"

    MsgBox "IJ Judge Verification completed successfully." & _
        vbCrLf & vbCrLf & _
        "All five verification checks completed." & _
        vbCrLf & _
        "Dashboard generated successfully.", _
        vbInformation

    ThisWorkbook.Worksheets("Dashboard").Activate

    Exit Sub

CheckFailed:

    failureMessage = "One or more verification checks failed. " & _
        "Review the processing indicators on the Tool tab."

    GoTo ShowFailure

ProcessFailed:

    failureMessage = Err.Description

ShowFailure:

    If Not tool Is Nothing Then
        tool.Range("B11").Value = "Not Ready"
    End If

    MsgBox "Report processing stopped." & vbCrLf & _
        failureMessage, vbExclamation

End Sub
