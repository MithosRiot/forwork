Sub ProcessAllReports()

    Dim tool As Worksheet
    Dim r As Long
    Dim missing As String

    On Error GoTo ProcessFailed

    Set tool = ThisWorkbook.Worksheets("Tool")

    UpdateStatuses

    ' Reset processing statuses
    tool.Range("B25:B28").Value = "Not Run"
    tool.Range("B11").Value = "Out of Date"

    ' Check all required imports
    For r = 6 To 8

        If tool.Cells(r, "B").Value <> "Imported" Then
            missing = missing & vbCrLf & _
                "- " & tool.Cells(r, "A").Value
        End If

    Next r

    If missing <> "" Then

        tool.Range("B11").Value = "Not Ready"

        MsgBox "Cannot process reports. Check:" & _
            vbCrLf & missing, vbExclamation

        Exit Sub

    End If

    ' Run checks in sequence.
    ' Stop immediately if any check fails.

    If Not CompareEnhancedDetained() Then GoTo ProcessFailed

    If Not CompareWebEx() Then GoTo ProcessFailed

    If Not CheckDFASVAV() Then GoTo ProcessFailed

    If Not CheckDFASHLOC() Then GoTo ProcessFailed

    ' All four checks completed successfully.
    ' Dashboard generation will be added next.
    tool.Range("B11").Value = "Out of Date"

    MsgBox "All four verification checks completed." & _
        vbCrLf & vbCrLf & _
        "Enhanced Detained: Complete" & vbCrLf & _
        "WebEx: Complete" & vbCrLf & _
        "DFAS VAV: Complete" & vbCrLf & _
        "DFAS HLOC: Complete" & vbCrLf & vbCrLf & _
        "Dashboard generation is not connected yet.", _
        vbInformation

    Exit Sub

ProcessFailed:

    tool.Range("B11").Value = "Not Ready"

    MsgBox "Processing stopped." & vbCrLf & _
        "Check the processing status indicators " & _
        "on the Tool tab.", vbExclamation

End Sub
