
Sub TestOutlookAccess()

    Dim outlookApp As Object
    Dim outlookNS As Object
    Dim inbox As Object
    Dim mailItems As Object

    On Error GoTo TestFailed

    ' Connect to classic Outlook.
    Set outlookApp = GetObject(, "Outlook.Application")

    Set outlookNS = outlookApp.GetNamespace("MAPI")
    Set inbox = outlookNS.GetDefaultFolder(6)

    Set mailItems = inbox.Items

    MsgBox "Outlook connection successful!" & vbCrLf & _
           "Mailbox: " & inbox.FolderPath & vbCrLf & _
           "Inbox item count: " & mailItems.Count, _
           vbInformation, "Outlook Test"

    Exit Sub

TestFailed:

    MsgBox "Outlook connection failed." & vbCrLf & _
           "Error: " & Err.Description, _
           vbCritical, "Outlook Test"

End Sub
