Function ValidateReport( _
    ws As Worksheet, reportType As String) As Boolean

    Dim headers As Variant
    Dim positions As Variant
    Dim i As Long
    Dim actual As String
    Dim expected As String

    ValidateReport = False

    Select Case reportType

        Case "Enhanced Detained - Excel Data"

            positions = Array(1, 3, 5, 6, 9)
            headers = Array( _
                "Base City Code", _
                "Hearing Loc Code", _
                "IJ Code", _
                "IJ Name", _
                "NFH Date")

        Case "Detained Ops IJ WebEx Data"

            positions = Array(2, 3, 4, 8, 9, 10)
            headers = Array( _
                "Last Name", _
                "First", _
                "IJ Code", _
                "Home Court", _
                "Detail Court", _
                "HLOC")

        Case "DFAS EIOR Judge List Data"

            positions = Array(1, 2, 5, 6)
            headers = Array( _
                "judge_code", _
                "judge_name", _
                "vav_court", _
                "detail_court")

        Case Else

            MsgBox "Unknown report type: " & reportType, _
                vbCritical
            Exit Function

    End Select

    For i = LBound(headers) To UBound(headers)

        expected = LCase(Trim(CStr(headers(i))))

        actual = LCase(Trim(CStr( _
            ws.Cells(1, positions(i)).Value)))

        If actual <> expected Then

            MsgBox "Incorrect report format." & vbCrLf & _
                "Expected column " & positions(i) & _
                ": " & headers(i) & vbCrLf & _
                "Found: " & actual, vbCritical

            Exit Function

        End If

    Next i

    ValidateReport = True

End Function
