' Verify that the imported file belongs to the selected date
If Not IsDate(tool.Range("F6").Value) Then
    MsgBox "No valid import reporting date found.", vbExclamation
    Exit Sub
End If

If CLng(CDate(tool.Range("F6").Value)) <> _
   CLng(reportDate) Then

    MsgBox "Enhanced Detained was imported for a different " & _
           "reporting date. Please import the correct file.", _
           vbExclamation
    Exit Sub

End If
