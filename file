Sub CheckDFASVAV()

    Dim tool As Worksheet
    Dim dfas As Worksheet
    Dim enhanced As Worksheet
    Dim webex As Worksheet
    Dim results As Worksheet

    Dim dfasCodes As Object
    Dim seen As Object
    Dim details As Variant

    Dim lastRow As Long
    Dim r As Long
    Dim code As String
    Dim vav As String
    Dim judgeName As String

    Dim enhancedRow As Long
    Dim webexRow As Long
    Dim missingED As Long
    Dim missingWE As Long
    Dim noED As Long
    Dim noWE As Long

    On Error GoTo CheckFailed

    Set tool = ThisWorkbook.Worksheets("Tool")
    Set dfas = ThisWorkbook.Worksheets( _
        "DFAS EIOR Judge List Data")
    Set enhanced = ThisWorkbook.Worksheets( _
        "Enhanced Detained - Excel Data")
    Set webex = ThisWorkbook.Worksheets( _
        "Detained Ops IJ WebEx Data")
    Set results = ThisWorkbook.Worksheets("Results_DFAS")

    UpdateStatuses

    For r = 6 To 8
        If tool.Cells(r, "B").Value <> "Imported" Then
            MsgBox "All three current reports must be imported.", _
                vbExclamation
            Exit Sub
        End If
    Next r

    Set dfasCodes = CreateObject("Scripting.Dictionary")
    dfasCodes.CompareMode = vbTextCompare

    lastRow = dfas.Cells(dfas.Rows.Count, "A").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(dfas.Cells(r, "A").Value)))

        If code <> "" Then
            If Not dfasCodes.Exists(code) Then
                dfasCodes.Add code, Array( _
                    dfas.Cells(r, "B").Value, _
                    dfas.Cells(r, "E").Value, _
                    dfas.Cells(r, "C").Value)
            End If
        End If

    Next r

    If dfasCodes.Count = 0 Then
        MsgBox "No valid DFAS judge codes found.", vbExclamation
        Exit Sub
    End If

    results.Range("A5:E10000").ClearContents
    results.Range("F5:J10000").ClearContents

    enhancedRow = 5
    webexRow = 5

    ' Enhanced Detained
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare

    lastRow = enhanced.Cells( _
        enhanced.Rows.Count, "E").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(enhanced.Cells(r, "E").Value)))

        If code <> "" And Not seen.Exists(code) Then

            seen.Add code, True

            judgeName = enhanced.Cells(r, "F").Value

            If dfasCodes.Exists(code) Then

                details = dfasCodes(code)
                vav = UCase(Trim(CStr(details(1))))

                If vav = "NO" Then

                    results.Cells(enhancedRow, "A").Value = code
                    results.Cells(enhancedRow, "B").Value = details(0)
                    results.Cells(enhancedRow, "C").Value = "No"
                    results.Cells(enhancedRow, "D").Value = details(2)
                    results.Cells(enhancedRow, "E").Value = "VAV = No"

                    enhancedRow = enhancedRow + 1
                    noED = noED + 1

                End If

            Else

                results.Cells(enhancedRow, "A").Value = code
                results.Cells(enhancedRow, "B").Value = judgeName
                results.Cells(enhancedRow, "C").Value = "No"
                results.Cells(enhancedRow, "D").Value = "Not Found"
                results.Cells(enhancedRow, "E").Value = _
                    "Missing from DFAS"

                enhancedRow = enhancedRow + 1
                missingED = missingED + 1

            End If

        End If

    Next r

    ' WebEx
    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare

    lastRow = webex.Cells( _
        webex.Rows.Count, "D").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(webex.Cells(r, "D").Value)))

        If code <> "" And Not seen.Exists(code) Then

            seen.Add code, True

            judgeName = Trim(CStr(webex.Cells(r, "B").Value)) _
                & ", " & Trim(CStr(webex.Cells(r, "C").Value))

            If dfasCodes.Exists(code) Then

                details = dfasCodes(code)
                vav = UCase(Trim(CStr(details(1))))

                If vav = "NO" Then

                    results.Cells(webexRow, "F").Value = code
                    results.Cells(webexRow, "G").Value = details(0)
                    results.Cells(webexRow, "H").Value = "No"
                    results.Cells(webexRow, "I").Value = details(2)
                    results.Cells(webexRow, "J").Value = "VAV = No"

                    webexRow = webexRow + 1
                    noWE = noWE + 1

                End If

            Else

                results.Cells(webexRow, "F").Value = code
                results.Cells(webexRow, "G").Value = judgeName
                results.Cells(webexRow, "H").Value = "No"
                results.Cells(webexRow, "I").Value = "Not Found"
                results.Cells(webexRow, "J").Value = _
                    "Missing from DFAS"

                webexRow = webexRow + 1
                missingWE = missingWE + 1

            End If

        End If

    Next r

    MsgBox "DFAS verification complete." & vbCrLf & vbCrLf & _
        "Enhanced Detained:" & vbCrLf & _
        "VAV No: " & noED & vbCrLf & _
        "Missing DFAS: " & missingED & vbCrLf & _
        "Total: " & (noED + missingED) & vbCrLf & vbCrLf & _
        "WebEx:" & vbCrLf & _
        "VAV No: " & noWE & vbCrLf & _
        "Missing DFAS: " & missingWE & vbCrLf & _
        "Total: " & (noWE + missingWE), vbInformation

    Exit Sub

CheckFailed:

    MsgBox "DFAS verification failed: " & _
        Err.Description, vbCritical

End Sub
