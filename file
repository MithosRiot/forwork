Sub UpdatePreviousReportDates()

    Dim ws As Worksheet
    Dim currentDate As Date
    Dim previousDate As Variant

    Set ws = ThisWorkbook.Worksheets("Tool")

    If Not IsDate(ws.Range("B3").Value) Then
        ws.Range("B16:B17").ClearContents
        Exit Sub
    End If

    currentDate = DateValue(ws.Range("B3").Value)

    ' Enhanced Detained previous report
    previousDate = GetPreviousReportDate( _
        "History_enhancedDetained", currentDate)

    If IsEmpty(previousDate) Then
        ws.Range("B16").Value = "Not Available"
    Else
        ws.Range("B16").Value = previousDate
        ws.Range("B16").NumberFormat = "mmm d, yyyy"
    End If

    ' WebEx previous report
    previousDate = GetPreviousReportDate( _
        "History_webEx", currentDate)

    If IsEmpty(previousDate) Then
        ws.Range("B17").Value = "Not Available"
    Else
        ws.Range("B17").Value = previousDate
        ws.Range("B17").NumberFormat = "mmm d, yyyy"
    End If

End Sub
