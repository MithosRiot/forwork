Function GetPreviousReportDate( _
    historySheet As String, _
    currentDate As Date) As Variant

    Dim ws As Worksheet
    Dim lastRow As Long
    Dim r As Long
    Dim reportDate As Date
    Dim previousDate As Date
    Dim found As Boolean

    Set ws = ThisWorkbook.Worksheets(historySheet)

    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row

    found = False

    For r = 2 To lastRow

        If IsDate(ws.Cells(r, "A").Value) Then

            reportDate = DateValue(ws.Cells(r, "A").Value)

            If reportDate < currentDate Then

                If Not found Or reportDate > previousDate Then
                    previousDate = reportDate
                    found = True
                End If

            End If

        End If

    Next r

    If found Then
        GetPreviousReportDate = previousDate
    Else
        GetPreviousReportDate = Empty
    End If

End Function
