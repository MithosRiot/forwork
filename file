let
    URL = "https://www.justice.gov/eoir/find-immigration-court-and-access-internet-based-hearings",
    Source = Web.Page(Web.Contents(URL)),

    // Find tables, including those nested within page sections
    FindTables = (items as table, optional parent as nullable text) as list =>
        List.Combine(
            List.Transform(
                Table.ToRecords(items),
                (item) =>
                    let
                        Name = try Text.From(item[Name]) otherwise "",
                        Section = if Text.Contains(Name, "Immigration Court", Comparer.OrdinalIgnoreCase)
                                  then Name else parent,
                        Data = try item[Data] otherwise null,
                        Children = try item[Children] otherwise null,
                        Current = if Data is table and
                                     Table.ColumnCount(Data) = 3 and
                                     Section <> null
                                  then {[
                                      Court = Section,
                                      Data = Data
                                  ]} else {},
                        Nested = if Children is table
                                 then @FindTables(Children, Section)
                                 else {}
                    in
                        List.Combine({Current, Nested})
            )
        ),

    CourtTables = FindTables(Source),
    Output = Table.FromRecords(CourtTables)
in
    Output
