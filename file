let
    URL = "https://www.justice.gov/eoir/find-immigration-court-and-access-internet-based-hearings",
    Source = Web.Page(Web.Contents(URL)),

    // Keep only court tables
    Courts = Table.SelectRows(
        Source,
        each [Caption] <> null
            and Text.Contains(
                [Caption],
                "Immigration Court",
                Comparer.OrdinalIgnoreCase
            )
            and [Data] is table
    ),

    // Preserve the court name and expand judge information
    KeepColumns = Table.SelectColumns(
        Courts,
        {"Caption", "Data"}
    ),

    RenameCourt = Table.RenameColumns(
        KeepColumns,
        {{"Caption", "Court"}}
    ),

    // Combine each court's judge records
    AddJudges = Table.AddColumn(
        RenameCourt,
        "Judges",
        each
            let
                CourtName = [Court],
                JudgeData = [Data],
                WithCourt = Table.AddColumn(
                    JudgeData,
                    "Court",
                    each CourtName,
                    type text
                )
            in
                WithCourt
    ),

    Combined = Table.Combine(AddJudges[Judges])
in
    Combined
