Sub GenerateDashboardReport()

    Dim dash As Worksheet
    Dim src As Worksheet
    Dim nextRow As Long
    Dim lastRow As Long
    Dim r As Long
    Dim c As Long
    Dim sourceCol As Long
    Dim fieldCount As Long
    Dim sectionCount As Long
    Dim sectionTitle As String
    Dim sectionHeaders As Variant
    Dim sectionSheet As String
    Dim sections As Variant
    Dim item As Variant
    Dim sectionStart As Long

    On Error GoTo ReportFailed

    Set dash = ThisWorkbook.Worksheets("Dashboard")

    ' Do not modify the existing Dashboard header or summary.
    dash.Range("A18:F" & dash.Rows.Count).Clear

    nextRow = 18

    ' Each entry:
    ' Worksheet, title, first source column,
    ' number of fields, column headings
    sections = Array( _
        Array("Results_EnhancedDetained", _
            "ENHANCED DETAINED - ROLL-ONS", 1, 2, _
            Array("IJ Code", "Judge Name")), _
        Array("Results_EnhancedDetained", _
            "ENHANCED DETAINED - ROLL-OFFS", 4, 2, _
            Array("IJ Code", "Judge Name")), _
        Array("Results_DFAS", _
            "ENHANCED DETAINED - VAV COURT ISSUES", 1, 5, _
            Array("IJ Code", "Judge Name", "VAV Court", _
                  "DFAS Court", "Verification Status")), _
        Array("Results_HLOC", _
            "ENHANCED DETAINED - HLOC UPDATES", 1, 5, _
            Array("IJ Code", "Judge Name", "HLOC", _
                  "DFAS Detail Court", "Issue")), _
        Array("Results_WebEx", _
            "WEBEX - ROLL-ONS", 1, 2, _
            Array("IJ Code", "Judge Name")), _
        Array("Results_WebEx", _
            "WEBEX - ROLL-OFFS", 4, 2, _
            Array("IJ Code", "Judge Name")), _
        Array("Results_DFAS", _
            "WEBEX - VAV COURT ISSUES", 6, 5, _
            Array("IJ Code", "Judge Name", "VAV Court", _
                  "DFAS Court", "Verification Status")), _
        Array("Results_HLOC", _
            "WEBEX - HLOC UPDATES", 7, 5, _
            Array("IJ Code", "Judge Name", "HLOC", _
                  "DFAS Detail Court", "Issue")), _
        Array("Results_HLOC", _
            "WEBEX - HOME COURT = HLOC", 13, 5, _
            Array("IJ Code", "Judge Name", "Home Court", _
                  "HLOC", "DFAS Detail Court")) _
    )

    For Each item In sections

        sectionSheet = CStr(item(0))
        sectionTitle = CStr(item(1))
        sourceCol = CLng(item(2))
        fieldCount = CLng(item(3))
        sectionHeaders = item(4)

        Set src = ThisWorkbook.Worksheets(sectionSheet)

        ' Section title
        sectionStart = nextRow

        dash.Cells(nextRow, 1).Value = sectionTitle

        With dash.Range(dash.Cells(nextRow, 1), _
                        dash.Cells(nextRow, fieldCount))

            .Font.Bold = True
            .Font.Color = vbWhite
            .Interior.Color = RGB(45, 65, 85)

        End With

        nextRow = nextRow + 1

        ' Column headings
        For c = 0 To fieldCount - 1
            dash.Cells(nextRow, c + 1).Value = _
                sectionHeaders(c)
        Next c

        With dash.Range(dash.Cells(nextRow, 1), _
                        dash.Cells(nextRow, fieldCount))

            .Font.Bold = True
            .Interior.Color = RGB(220, 230, 240)
        End With

        nextRow = nextRow + 1

        ' Data always begins at row 5 of Results sheets.
        lastRow = src.Cells(src.Rows.Count, _
                           sourceCol).End(xlUp).Row

        sectionCount = 0

        For r = 5 To lastRow

            If Trim(CStr(src.Cells(r, sourceCol).Value)) <> "" Then

                For c = 0 To fieldCount - 1

                    dash.Cells(nextRow, c + 1).Value = _
                        src.Cells(r, sourceCol + c).Value

                Next c

                nextRow = nextRow + 1
                sectionCount = sectionCount + 1

            End If

        Next r

        If sectionCount = 0 Then

            dash.Cells(nextRow, 1).Value = "None"
            dash.Cells(nextRow, 1).Font.Italic = True

            nextRow = nextRow + 1

        End If

        ' One blank row between sections.
        nextRow = nextRow + 1

    Next item

    ' Format the generated report.
    dash.Range("A18:F" & nextRow).VerticalAlignment = _
        xlVAlignCenter

    dash.Range("A18:F" & nextRow).WrapText = False

    MsgBox "Dashboard detailed report generated." & _
        vbCrLf & "Sections: 9", vbInformation

    Exit Sub

ReportFailed:

    MsgBox "Dashboard generation failed: " & _
        Err.Description, vbCritical

End Sub
