
Sub AddVAVFacilityTable( _
    dash As Worksheet, ByRef nextRow As Long)

    Dim src As Worksheet
    Dim facilities As Object
    Dim facilityNames As Object
    Dim lastRow As Long
    Dim r As Long
    Dim facility As String
    Dim detloc As String
    Dim hloc As String
    Dim key As String
    Dim item As Variant
    Dim codes As String

    Set src = ThisWorkbook.Worksheets("Results_VAVBooths")

    Set facilities = CreateObject("Scripting.Dictionary")
    Set facilityNames = CreateObject("Scripting.Dictionary")

    facilities.CompareMode = vbTextCompare
    facilityNames.CompareMode = vbTextCompare

    ' Group missing HLOCs by facility.
    lastRow = src.Cells(src.Rows.Count, "A").End(xlUp).Row

    For r = 5 To lastRow

        facility = Trim(CStr(src.Cells(r, "A").Value))
        detloc = Trim(CStr(src.Cells(r, "B").Value))
        hloc = UCase(Trim(CStr(src.Cells(r, "D").Value)))

        If facility <> "" And hloc <> "" Then

            ' DETLOC distinguishes facilities with
            ' identical or similar names.
            key = UCase(facility) & "|" & UCase(detloc)

            If Not facilities.Exists(key) Then
                facilities.Add key, hloc
                facilityNames.Add key, facility
            Else
                codes = CStr(facilities(key))

                ' Avoid repeating the same HLOC.
                If Not HLOCInList(hloc, codes) Then
                    facilities(key) = codes & ", " & hloc
                End If
            End If

        End If

    Next r

    ' Section title.
    dash.Cells(nextRow, 1).Value = _
        "FACILITIES IN VAV BOOTHS BUT NOT ENHANCED DETAINED"

    With dash.Range(dash.Cells(nextRow, 1), _
                    dash.Cells(nextRow, 2))
        .Font.Bold = True
        .Font.Color = vbWhite
        .Interior.Color = RGB(45, 65, 85)
    End With

    nextRow = nextRow + 1

    ' Column headings.
    dash.Cells(nextRow, 1).Value = "Facility Name"
    dash.Cells(nextRow, 2).Value = "Missing HLOC(s)"

    With dash.Range(dash.Cells(nextRow, 1), _
                    dash.Cells(nextRow, 2))
        .Font.Bold = True
        .Interior.Color = RGB(220, 230, 240)
    End With

    nextRow = nextRow + 1

    If facilities.Count = 0 Then
        dash.Cells(nextRow, 1).Value = "None"
        nextRow = nextRow + 2
        Exit Sub
    End If

    For Each item In facilities.Keys

        dash.Cells(nextRow, 1).Value = facilityNames(item)
        dash.Cells(nextRow, 2).Value = facilities(item)

        nextRow = nextRow + 1

    Next item

    nextRow = nextRow + 1

End Sub
