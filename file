
Function CheckVAVBooths() As Boolean

    Dim tool As Worksheet
    Dim ed As Worksheet
    Dim vav As Worksheet
    Dim results As Worksheet

    Dim edCodes As Object
    Dim seen As Object

    Dim lastRow As Long
    Dim r As Long
    Dim i As Long
    Dim code As String
    Dim rawHLOC As String
    Dim parts As Variant
    Dim facility As String
    Dim detloc As String
    Dim key As String
    Dim outputRow As Long
    Dim missingCount As Long
    Dim failureMessage As String

    CheckVAVBooths = False
    On Error GoTo CheckFailed

    Set tool = ThisWorkbook.Worksheets("Tool")
    Set ed = ThisWorkbook.Worksheets( _
        "Enhanced Detained - Excel Data")
    Set vav = ThisWorkbook.Worksheets("VAV_Booth_Data")
    Set results = ThisWorkbook.Worksheets("Results_VAVBooths")

    ' Validate selected reporting week and imports.
    If Not IsDate(tool.Range("B3").Value) Then
        Err.Raise vbObjectError + 1201, , _
            "Select a valid reporting Friday."
    End If

    UpdateStatuses

    If tool.Range("B6").Value <> "Imported" Then
        Err.Raise vbObjectError + 1202, , _
            "Enhanced Detained must be current."
    End If

    If tool.Range("B9").Value <> "Imported" Then
        Err.Raise vbObjectError + 1203, , _
            "VAV Booth report must be imported."
    End If

    If Not IsDate(tool.Range("F9").Value) Then
        Err.Raise vbObjectError + 1204, , _
            "VAV Booth reporting date is missing."
    End If

    If DateValue(tool.Range("F9").Value) <> _
        DateValue(tool.Range("B3").Value) Then

        Err.Raise vbObjectError + 1205, , _
            "VAV Booth import is for a different Friday."

    End If

    Set edCodes = CreateObject("Scripting.Dictionary")
    Set seen = CreateObject("Scripting.Dictionary")

    edCodes.CompareMode = vbTextCompare
    seen.CompareMode = vbTextCompare

    ' Build unique Enhanced Detained HLOC list.
    lastRow = ed.Cells(ed.Rows.Count, "C").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(ed.Cells(r, "C").Value)))

        If code <> "" Then
            If Not edCodes.Exists(code) Then
                edCodes.Add code, True
            End If
        End If

    Next r

    If edCodes.Count = 0 Then
        Err.Raise vbObjectError + 1206, , _
            "No Enhanced Detained HLOC codes found."
    End If

    ' Verify VAV Booth headers before processing.
    If UCase(Trim(CStr(vav.Range("E1").Value))) <> "HLOC" Then
        Err.Raise vbObjectError + 1207, , _
            "VAV Booth column E must contain HLOC."
    End If

    ' Clear previous results, preserving headings.
    results.Range("A5:G10000").ClearContents

    outputRow = 5

    ' Read each VAV facility and split multiple HLOCs.
    lastRow = vav.Cells(vav.Rows.Count, "E").End(xlUp).Row

    For r = 2 To lastRow

        facility = Trim(CStr(vav.Cells(r, "C").Value))
        detloc = Trim(CStr(vav.Cells(r, "A").Value))

        rawHLOC = CStr(vav.Cells(r, "E").Value)

        ' Normalize Windows and Unix line breaks.
        rawHLOC = Replace(rawHLOC, vbCrLf, vbLf)
        rawHLOC = Replace(rawHLOC, vbCr, vbLf)

        parts = Split(rawHLOC, vbLf)

        For i = LBound(parts) To UBound(parts)

            code = UCase(Trim(CStr(parts(i))))

            If code <> "" Then

                key = UCase(detloc) & "|" & _
                    UCase(facility) & "|" & code

                If Not edCodes.Exists(code) Then

                    If Not seen.Exists(key) Then

                        seen.Add key, True

                        results.Cells(outputRow, "A").Value = facility
                        results.Cells(outputRow, "B").Value = detloc
                        results.Cells(outputRow, "C").Value = _
                            vav.Cells(r, "D").Value

                        results.Cells(outputRow, "D").Value = code

                        results.Cells(outputRow, "E").Value = _
                            vav.Cells(r, "F").Value

                        results.Cells(outputRow, "F").Value = _
                            vav.Cells(r, "H").Value

                        results.Cells(outputRow, "G").Value = _
                            "Not in Enhanced Detained"

                        outputRow = outputRow + 1
                        missingCount = missingCount + 1

                    End If

                End If

            End If

        Next i

    Next r

    If missingCount = 0 Then
        results.Range("A5").Value = "None"
    End If

    CheckVAVBooths = True

    MsgBox "VAV Booth verification complete." & vbCrLf & _
        "Missing HLOCs: " & missingCount, vbInformation

    Exit Function

CheckFailed:

    failureMessage = Err.Description

    If Not tool Is Nothing Then
        tool.Range("B11").Value = "Not Ready"
    End If

    MsgBox "VAV Booth verification failed: " & _
        failureMessage, vbCritical

    CheckVAVBooths = False

End Function
