Function CheckDFASHLOC() As Boolean

    Dim tool As Worksheet
    Dim dfas As Worksheet
    Dim ed As Worksheet
    Dim webex As Worksheet
    Dim results As Worksheet

    Dim dfasCodes As Object
    Dim seen As Object

    Dim lastRow As Long
    Dim r As Long
    Dim code As String
    Dim hloc As String
    Dim homeCourt As String
    Dim detailCourts As String
    Dim judgeName As String
    Dim issue As String
    Dim key As String

    Dim edRow As Long
    Dim webexRow As Long
    Dim sameRow As Long
    Dim failureMessage As String

    CheckDFASHLOC = False
    On Error GoTo CheckFailed

    Set tool = ThisWorkbook.Worksheets("Tool")
    Set dfas = ThisWorkbook.Worksheets( _
        "DFAS EIOR Judge List Data")
    Set ed = ThisWorkbook.Worksheets( _
        "Enhanced Detained - Excel Data")
    Set webex = ThisWorkbook.Worksheets( _
        "Detained Ops IJ WebEx Data")
    Set results = ThisWorkbook.Worksheets("Results_HLOC")

    tool.Range("B28").Value = "Running"
    tool.Range("B11").Value = "Out of Date"
    DoEvents

    ' Verify current imports
    UpdateStatuses

    For r = 6 To 8

        If tool.Cells(r, "B").Value <> "Imported" Then
            Err.Raise vbObjectError + 901, , _
                "All three current reports must be imported."
        End If

    Next r

    ' Build DFAS lookup:
    ' Column A = IJ Code
    ' Column F = Detail Court
    Set dfasCodes = CreateObject("Scripting.Dictionary")
    dfasCodes.CompareMode = vbTextCompare

    lastRow = dfas.Cells(dfas.Rows.Count, "A").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(dfas.Cells(r, "A").Value)))

        If code <> "" Then

            If Not dfasCodes.Exists(code) Then
                dfasCodes.Add code, _
                    CStr(dfas.Cells(r, "F").Value)
            End If

        End If

    Next r

    If dfasCodes.Count = 0 Then
        Err.Raise vbObjectError + 902, , _
            "No IJ Codes found in DFAS."
    End If

    ' Clear previous results, preserving headings
    results.Range("A5:E10000").ClearContents
    results.Range("G5:K10000").ClearContents
    results.Range("M5:Q10000").ClearContents

    edRow = 5
    webexRow = 5
    sameRow = 5

    ' ---------------------------------
    ' ENHANCED DETAINED HLOC CHECK
    ' ---------------------------------

    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare

    lastRow = ed.Cells(ed.Rows.Count, "E").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(ed.Cells(r, "E").Value)))
        hloc = UCase(Trim(CStr(ed.Cells(r, "C").Value)))
        judgeName = Trim(CStr(ed.Cells(r, "F").Value))

        If code <> "" And hloc <> "" Then

            key = code & "|" & hloc

            If Not seen.Exists(key) Then

                seen.Add key, True

                detailCourts = ""
                issue = ""

                If Not dfasCodes.Exists(code) Then

                    issue = "IJ Missing from DFAS"

                Else

                    detailCourts = CStr(dfasCodes(code))

                    If Not HLOCInList(hloc, detailCourts) Then
                        issue = "Missing HLOC"
                    End If

                End If

                If issue <> "" Then

                    results.Cells(edRow, "A").Value = code
                    results.Cells(edRow, "B").Value = judgeName
                    results.Cells(edRow, "C").Value = hloc
                    results.Cells(edRow, "D").Value = detailCourts
                    results.Cells(edRow, "E").Value = issue

                    edRow = edRow + 1

                End If

            End If

        End If

    Next r

    ' ---------------------------------
    ' WEBEX HLOC CHECK
    ' ---------------------------------

    Set seen = CreateObject("Scripting.Dictionary")
    seen.CompareMode = vbTextCompare

    lastRow = webex.Cells(webex.Rows.Count, "D").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(webex.Cells(r, "D").Value)))
        hloc = UCase(Trim(CStr(webex.Cells(r, "J").Value)))
        homeCourt = UCase(Trim(CStr(webex.Cells(r, "H").Value)))

        judgeName = Trim(CStr(webex.Cells(r, "B").Value)) _
            & ", " & Trim(CStr(webex.Cells(r, "C").Value))

        If code <> "" And hloc <> "" Then

            key = code & "|" & hloc

            If Not seen.Exists(key) Then

                seen.Add key, True

                detailCourts = ""
                issue = ""

                If Not dfasCodes.Exists(code) Then

                    issue = "IJ Missing from DFAS"

                Else

                    detailCourts = CStr(dfasCodes(code))

                    If Not HLOCInList(hloc, detailCourts) Then
                        issue = "Missing HLOC"
                    End If

                End If

                ' Missing HLOC and unmatched IJ findings
                If issue <> "" Then

                    results.Cells(webexRow, "G").Value = code
                    results.Cells(webexRow, "H").Value = judgeName
                    results.Cells(webexRow, "I").Value = hloc
                    results.Cells(webexRow, "J").Value = detailCourts
                    results.Cells(webexRow, "K").Value = issue

                    webexRow = webexRow + 1

                End If

                ' Independent Home Court = HLOC finding
                If homeCourt <> "" And homeCourt = hloc Then

                    results.Cells(sameRow, "M").Value = code
                    results.Cells(sameRow, "N").Value = judgeName
                    results.Cells(sameRow, "O").Value = homeCourt
                    results.Cells(sameRow, "P").Value = hloc
                    results.Cells(sameRow, "Q").Value = detailCourts

                    sameRow = sameRow + 1

                End If

            End If

        End If

    Next r

    ' Successful processing
    tool.Range("B28").Value = "Complete"

    CheckDFASHLOC = True
    Exit Function

CheckFailed:

    failureMessage = Err.Description

    If Not tool Is Nothing Then
        tool.Range("B28").Value = "Failed"
        tool.Range("B11").Value = "Not Ready"
    End If

    MsgBox "DFAS HLOC verification failed: " & _
        failureMessage, vbCritical

    CheckDFASHLOC = False

End Function
