Sub SaveWebExHistory()

    Dim src As Worksheet
    Dim hist As Worksheet
    Dim tool As Worksheet
    Dim backup As Worksheet

    Dim reportDate As Date
    Dim lastRow As Long
    Dim nextRow As Long
    Dim existingRow As Long
    Dim r As Long

    Dim errorMessage As String
    Dim backupComplete As Boolean
    Dim historyModified As Boolean
    Dim restoreSuccessful As Boolean

    On Error GoTo SaveFailed

    Set src = ThisWorkbook.Sheets("Detained Ops IJ WebEx Data")
    Set hist = ThisWorkbook.Sheets("History_webEx")
    Set tool = ThisWorkbook.Sheets("Tool")
    Set backup = ThisWorkbook.Sheets("History_Backup")

    ' Verify the selected reporting date
    If Not IsDate(tool.Range("B3").Value) Then
        Err.Raise vbObjectError + 201, , _
            "Select a valid reporting Friday."
    End If

    reportDate = DateValue(tool.Range("B3").Value)

    ' Verify the imported report belongs to this date
    If Not IsDate(tool.Range("F7").Value) Then
        Err.Raise vbObjectError + 202, , _
            "No valid WebEx import reporting date found."
    End If

    If DateValue(tool.Range("F7").Value) <> reportDate Then
        Err.Raise vbObjectError + 203, , _
            "WebEx was imported for a different reporting date."
    End If

    ' Verify source data exists
    lastRow = src.Cells(src.Rows.Count, "D").End(xlUp).Row

    If lastRow < 2 Then
        Err.Raise vbObjectError + 204, , _
            "No WebEx data available to archive."
    End If

