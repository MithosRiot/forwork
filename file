
Sub DiagnoseOutlookReportMatch()

    Dim olApp As Object
    Dim olNS As Object
    Dim inbox As Object
    Dim items As Object
    Dim mail As Object
    Dim att As Object
    Dim senderSMTP As String
    Dim exUser As Object
    Dim i As Long
    Dim matched As Long
    Dim details As String

    On Error GoTo Failed

    Set olApp = GetObject(, "Outlook.Application")
    Set olNS = olApp.GetNamespace("MAPI")
    Set inbox = olNS.GetDefaultFolder(6)

    Set items = inbox.Items
    items.Sort "[ReceivedTime]", True

    For i = 1 To items.Count

        If items(i).Class = 43 Then

            Set mail = items(i)

            If InStr(1, mail.Subject, _
                "EIOR Detained Ops Dockets", _
                vbTextCompare) > 0 Then

                matched = matched + 1

                senderSMTP = mail.SenderEmailAddress

                If mail.SenderEmailType = "EX" Then
                    Set exUser = Nothing

                    On Error Resume Next
                    Set exUser = _
                        mail.Sender.GetExchangeUser()

                    If Not exUser Is Nothing Then
                        senderSMTP = _
                            exUser.PrimarySmtpAddress
                    End If

                    On Error GoTo Failed
                End If

                details = _
                    "Received: " & mail.ReceivedTime & vbCrLf & _
                    "Sender: " & senderSMTP & vbCrLf & _
                    "Subject: " & mail.Subject & vbCrLf & _
                    "Attachments: " & mail.Attachments.Count & _
                    vbCrLf & vbCrLf

                For Each att In mail.Attachments
                    details = details & _
                        att.FileName & vbCrLf
                Next att

                Debug.Print details

                MsgBox details, vbInformation, _
                    "Matching Outlook Email"

                Exit Sub

            End If

        End If

    Next i

    MsgBox "No messages matched the subject." & _
        vbCrLf & "Emails examined: " & items.Count, _
        vbExclamation

    Exit Sub

Failed:
    MsgBox "Diagnostic failed: " & Err.Description, _
        vbCritical

End Sub
