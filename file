If Len(selectedPath) > 0 Then

    ' Automated import: use supplied file path.
    filePath = selectedPath

Else

    ' Manual import: display file picker.
    filePath = Application.GetOpenFilename( _
        "Excel and CSV Files (*.xlsx;*.xlsm;*.csv)," & _
        "*.xlsx;*.xlsm;*.csv", , _
        "Select " & reportName & " Report")

    If VarType(filePath) = vbBoolean Then Exit Sub

End If
