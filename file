Sub GenerateDashboardReport()

    Dim dash As Worksheet
    Dim nextRow As Long

    On Error GoTo ReportFailed

    Set dash = ThisWorkbook.Worksheets("Dashboard")

    ' Preserve the Dashboard summary and header
    dash.Range("A18:F" & dash.Rows.Count).Clear

    nextRow = 18

    ' Enhanced Detained
    AddReportSection dash, nextRow, _
        "Results_EnhancedDetained", _
        "ENHANCED DETAINED - ROLL-ONS", 1, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_EnhancedDetained", _
        "ENHANCED DETAINED - ROLL-OFFS", 4, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_DFAS", _
        "ENHANCED DETAINED - VAV COURT ISSUES", 1, _
        Array("IJ Code", "Judge Name", "VAV Court", _
              "DFAS Court", "Verification Status")

    AddReportSection dash, nextRow, _
        "Results_HLOC", _
        "ENHANCED DETAINED - HLOC UPDATES", 1, _
        Array("IJ Code", "Judge Name", "HLOC", _
              "DFAS Detail Court", "Issue")

    ' WebEx
    AddReportSection dash, nextRow, _
        "Results_WebEx", _
        "WEBEX - ROLL-ONS", 1, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_WebEx", _
        "WEBEX - ROLL-OFFS", 4, _
        Array("IJ Code", "Judge Name")

    AddReportSection dash, nextRow, _
        "Results_DFAS", _
        "WEBEX - VAV COURT ISSUES", 6, _
        Array("IJ Code", "Judge Name", "VAV Court", _
              "DFAS Court", "Verification Status")

    AddReportSection dash, nextRow, _
        "Results_HLOC", _
        "WEBEX - HLOC UPDATES", 7, _
        Array("IJ Code", "Judge Name", "HLOC", _
              "DFAS Detail Court", "Issue")

    AddReportSection dash, nextRow, _
        "Results_HLOC", _
        "WEBEX - HOME COURT = HLOC", 13, _
        Array("IJ Code", "Judge Name", "Home Court", _
              "HLOC", "DFAS Detail Court")

    MsgBox "Dashboard report generated successfully.", _
        vbInformation

    Exit Sub

ReportFailed:

    MsgBox "Dashboard generation failed: " & _
        Err.Description, vbCritical

End Sub


Sub AddReportSection( _
    dash As Worksheet, _
    ByRef nextRow As Long, _
    sourceSheet As String, _
    sectionTitle As String, _
    sourceCol As Long, _
    headers As Variant)

    Dim src As Worksheet
    Dim fieldCount As Long
    Dim lastRow As Long
    Dim r As Long
    Dim c As Long
    Dim count As Long

    Set src = ThisWorkbook.Worksheets(sourceSheet)

    fieldCount = UBound(headers) - LBound(headers) + 1

    ' Section title
    dash.Cells(nextRow, 1).Value = sectionTitle

    With dash.Range(dash.Cells(nextRow, 1), _
                    dash.Cells(nextRow, fieldCount))

        .Font.Bold = True
        .Font.Color = vbWhite
        .Interior.Color = RGB(45, 65, 85)

    End With

    nextRow = nextRow + 1

    ' Column headings
    For c = 0 To fieldCount - 1
        dash.Cells(nextRow, c + 1).Value = headers(c)
    Next c

    With dash.Range(dash.Cells(nextRow, 1), _
                    dash.Cells(nextRow, fieldCount))

        .Font.Bold = True
        .Interior.Color = RGB(220, 230, 240)

    End With

    nextRow = nextRow + 1

    lastRow = src.Cells(src.Rows.Count, _
                       sourceCol).End(xlUp).Row

    count = 0

    ' Copy matching results
    For r = 5 To lastRow

        If Trim(CStr(src.Cells(r, sourceCol).Value)) <> "" Then

            For c = 0 To fieldCount - 1

                dash.Cells(nextRow, c + 1).Value = _
                    src.Cells(r, sourceCol + c).Value

            Next c

            nextRow = nextRow + 1
            count = count + 1

        End If

    Next r

    If count = 0 Then

        dash.Cells(nextRow, 1).Value = "None"
        dash.Cells(nextRow, 1).Font.Italic = True

        nextRow = nextRow + 1

    End If

    ' Blank row between sections
    nextRow = nextRow + 1

End Sub
