Private Sub Worksheet_Change(ByVal Target As Range)

    If Intersect(Target, Me.Range("B3")) Is Nothing Then
        Exit Sub
    End If

    On Error GoTo ChangeFailed

    Application.EnableEvents = False

    ' Refresh imported report statuses
    UpdateStatuses

    ' Refresh previous report dates
    UpdatePreviousReportDates

    ' Invalidate previous processing results
    ResetProcessingStatus

CleanExit:
    Application.EnableEvents = True
    Exit Sub

ChangeFailed:
    MsgBox "Reporting week update failed: " & _
        Err.Description, vbExclamation

    Resume CleanExit

End Sub
