Sub CompareEnhancedDetained()

    Dim ws As Worksheet
    Dim hist As Worksheet
    Dim results As Worksheet
    Dim tool As Worksheet

    Dim currentCodes As Object
    Dim previousCodes As Object

    Dim currentDate As Date
    Dim previousDate As Variant
    Dim lastRow As Long
    Dim r As Long
    Dim code As String
    Dim key As Variant
    Dim onRow As Long
    Dim offRow As Long

    On Error GoTo CompareFailed

    Set ws = ThisWorkbook.Worksheets( _
        "Enhanced Detained - Excel Data")

    Set hist = ThisWorkbook.Worksheets( _
        "History_enhancedDetained")

    Set results = ThisWorkbook.Worksheets( _
        "Results_EnhancedDetained")

    Set tool = ThisWorkbook.Worksheets("Tool")

    Set currentCodes = CreateObject("Scripting.Dictionary")
    Set previousCodes = CreateObject("Scripting.Dictionary")

    currentCodes.CompareMode = vbTextCompare
    previousCodes.CompareMode = vbTextCompare

    ' Validate the selected reporting date
    If Not IsDate(tool.Range("B3").Value) Then
        MsgBox "Select a valid reporting date.", vbExclamation
        Exit Sub
    End If

    currentDate = DateValue(tool.Range("B3").Value)

    ' Ensure the current imported report is selected
    If tool.Range("B6").Value <> "Imported" Then
        MsgBox "Import the current Enhanced Detained report.", _
            vbExclamation
        Exit Sub
    End If

    ' Find the most recent previous report
    previousDate = GetPreviousReportDate( _
        "History_enhancedDetained", currentDate)

    If IsEmpty(previousDate) Then
        MsgBox "No previous Enhanced Detained report found.", _
            vbExclamation
        Exit Sub
    End If

    ' Read unique IJ Codes from the current report
    lastRow = ws.Cells(ws.Rows.Count, "E").End(xlUp).Row

    For r = 2 To lastRow

        code = UCase(Trim(CStr(ws.Cells(r, "E").Value)))

        If code <> "" Then
            If Not currentCodes.Exists(code) Then
                currentCodes.Add code, ws.Cells(r, "F").Value
            End If
        End If

    Next r

    ' Read unique IJ Codes from previous history
    lastRow = hist.Cells(hist.Rows.Count, "A").End(xlUp).Row

    For r = 2 To lastRow

        If IsDate(hist.Cells(r, "A").Value) Then

            If DateValue(hist.Cells(r, "A").Value) = _
                CDate(previousDate) Then

                code = UCase(Trim(CStr(hist.Cells(r, "B").Value)))

                If code <> "" Then
                    If Not previousCodes.Exists(code) Then
                        previousCodes.Add code, _
                            hist.Cells(r, "D").Value
                    End If
                End If

            End If

        End If

    Next r

    If currentCodes.Count = 0 Or previousCodes.Count = 0 Then
        MsgBox "One of the reports contains no IJ Codes.", _
            vbExclamation
        Exit Sub
    End If

    ' Clear previous results, preserving headings
    results.Range("A5:B10000").ClearContents
    results.Range("D5:E10000").ClearContents

    onRow = 5
    offRow = 5

    ' ROLL-ONS:
    ' IJ Codes present now but absent previously
    For Each key In currentCodes.Keys

        If Not previousCodes.Exists(key) Then

            results.Cells(onRow, "A").Value = key
            results.Cells(onRow, "B").Value = _
                currentCodes(key)

            onRow = onRow + 1

        End If

    Next key

    ' ROLL-OFFS:
    ' IJ Codes previously present but absent now
    For Each key In previousCodes.Keys

        If Not currentCodes.Exists(key) Then

            results.Cells(offRow, "D").Value = key
            results.Cells(offRow, "E").Value = _
                previousCodes(key)

            offRow = offRow + 1

        End If

    Next key

    ' Record comparison dates
    results.Range("A2").Value = "Current Report:"
    results.Range("B2").Value = currentDate
    results.Range("B2").NumberFormat = "mmm d, yyyy"

    results.Range("D2").Value = "Previous Report:"
    results.Range("E2").Value = CDate(previousDate)
    results.Range("E2").NumberFormat = "mmm d, yyyy"

    MsgBox "Enhanced Detained comparison complete." & _
        vbCrLf & vbCrLf & _
        "Roll-Ons: " & (onRow - 5) & vbCrLf & _
        "Roll-Offs: " & (offRow - 5), _
        vbInformation

    Exit Sub

CompareFailed:

    MsgBox "Enhanced Detained comparison failed: " & _
        Err.Description, vbCritical

End Sub
