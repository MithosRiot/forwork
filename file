Function SaveEnhancedHistory() As Boolean

    Dim src As Worksheet
    Dim hist As Worksheet
    Dim tool As Worksheet
    Dim backup As Worksheet

    Dim reportDate As Date
    Dim lastRow As Long
    Dim nextRow As Long
    Dim existingRow As Long
    Dim r As Long

    Dim backupComplete As Boolean
    Dim historyModified As Boolean
    Dim failureMessage As String

    SaveEnhancedHistory = False
    On Error GoTo SaveFailed

    Set src = ThisWorkbook.Sheets( _
        "Enhanced Detained - Excel Data")

    Set hist = ThisWorkbook.Sheets( _
        "History_enhancedDetained")

    Set tool = ThisWorkbook.Sheets("Tool")
    Set backup = ThisWorkbook.Sheets("History_Backup")

    ' Validate reporting date
    If Not IsDate(tool.Range("B3").Value) Then
        Err.Raise vbObjectError + 301, , _
            "Invalid reporting date."
    End If

    reportDate = DateValue(tool.Range("B3").Value)

    ' Confirm imported data matches selected date
    If Not IsDate(tool.Range("F6").Value) Then
        Err.Raise vbObjectError + 302, , _
            "Enhanced Detained import date is missing."
    End If

    If DateValue(tool.Range("F6").Value) <> reportDate Then
        Err.Raise vbObjectError + 303, , _
            "Enhanced Detained was imported for another date."
    End If

    ' Verify source data exists
    lastRow = src.Cells(src.Rows.Count, "E").End(xlUp).Row

    If lastRow < 2 Then
        Err.Raise vbObjectError + 304, , _
            "No Enhanced Detained data available."
    End If

    ' Back up existing history
    backup.Cells.Clear
    hist.UsedRange.Copy Destination:=backup.Range("A1")
    backupComplete = True

    ' Remove existing snapshot for this date
    For existingRow = hist.Cells(hist.Rows.Count, "A") _
        .End(xlUp).Row To 2 Step -1

        If IsDate(hist.Cells(existingRow, "A").Value) Then

            If DateValue(hist.Cells(existingRow, "A").Value) = _
                reportDate Then

                historyModified = True
                hist.Rows(existingRow).Delete

            End If

        End If

    Next existingRow

    ' Save new snapshot
    For r = 2 To lastRow

        If Trim(CStr(src.Cells(r, "E").Value)) <> "" Then

            nextRow = hist.Cells(hist.Rows.Count, "A") _
                .End(xlUp).Row + 1

            historyModified = True

            hist.Cells(nextRow, "A").Value = reportDate
            hist.Cells(nextRow, "B").Value = src.Cells(r, "E").Value
            hist.Cells(nextRow, "C").Value = src.Cells(r, "C").Value
            hist.Cells(nextRow, "D").Value = src.Cells(r, "F").Value
            hist.Cells(nextRow, "E").Value = src.Cells(r, "A").Value
            hist.Cells(nextRow, "F").Value = src.Cells(r, "I").Value

        End If

    Next r

    hist.Columns("A").NumberFormat = "mm/dd/yyyy"

    SaveEnhancedHistory = True
    Exit Function

SaveFailed:

    failureMessage = Err.Description

    If historyModified And backupComplete Then

        On Error Resume Next

        Err.Clear
        hist.Cells.Clear
        backup.UsedRange.Copy Destination:=hist.Range("A1")

        If Err.Number <> 0 Then
            failureMessage = failureMessage & _
                vbCrLf & "History restoration also failed."
        End If

        On Error GoTo 0

    End If

    MsgBox "Enhanced Detained history error: " & _
        failureMessage, vbCritical

    SaveEnhancedHistory = False

End Function
