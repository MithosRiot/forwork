
Sub TestOutlookEmailSearch()

    Dim outlookApp As Object
    Dim outlookNS As Object
    Dim inbox As Object
    Dim items As Object
    Dim mail As Object
    Dim attachment As Object

    Dim ws As Worksheet
    Dim r As Long
    Dim i As Long
    Dim count As Long
    Dim attachmentNames As String

    On Error GoTo TestFailed

    Set outlookApp = GetObject(, "Outlook.Application")
    Set outlookNS = outlookApp.GetNamespace("MAPI")
    Set inbox = outlookNS.GetDefaultFolder(6)

    Set items = inbox.Items
    items.Sort "[ReceivedTime]", True

    ' Create a temporary worksheet for the search results.
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets("Outlook_Test")
    On Error GoTo TestFailed

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add
        ws.Name = "Outlook_Test"
    Else
        ws.Cells.ClearContents
    End If

    ws.Range("A1:E1").Value = Array( _
        "Received", "Sender", "Subject", _
        "Attachments", "Attachment Count")

    r = 2
    count = 0

    For i = 1 To items.Count

        If items(i).Class = 43 Then

            Set mail = items(i)
            attachmentNames = ""

            For Each attachment In mail.Attachments

                If attachmentNames <> "" Then
                    attachmentNames = attachmentNames & "; "
                End If

                attachmentNames = attachmentNames & _
                    attachment.FileName

            Next attachment

            ws.Cells(r, 1).Value = mail.ReceivedTime
            ws.Cells(r, 2).Value = mail.SenderName
            ws.Cells(r, 3).Value = mail.Subject
            ws.Cells(r, 4).Value = attachmentNames
            ws.Cells(r, 5).Value = mail.Attachments.Count

            r = r + 1
            count = count + 1

            If count >= 20 Then Exit For

        End If

    Next i

    ws.Range("A1:E1").Font.Bold = True
    ws.Columns("A").ColumnWidth = 20
    ws.Columns("B").ColumnWidth = 25
    ws.Columns("C").ColumnWidth = 45
    ws.Columns("D").ColumnWidth = 50
    ws.Columns("E").ColumnWidth = 18

    ws.Columns("A").NumberFormat = "mm/dd/yyyy hh:mm"

    ws.Activate

    MsgBox count & " recent emails listed.", _
        vbInformation, "Outlook Search Test"

    Exit Sub

TestFailed:

    MsgBox "Outlook search failed: " & _
        Err.Description, vbCritical

End Sub
